{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Backend: compilar",
            "type": "shell",
            "command": "./mvnw",
            "windows": { "command": ".\\mvnw.cmd" },
            "args": ["compile"],
            "options": { "cwd": "${workspaceFolder}" },
            "group": { "kind": "build", "isDefault": true },
            "problemMatcher": []
        },
        {
            "label": "Backend: testar persistencia",
            "type": "shell",
            "command": "./mvnw",
            "windows": { "command": ".\\mvnw.cmd" },
            "args": ["-Dtest=ConversationPersistenceServiceTest,ConversationMemoryPersistenceServiceTest", "test"],
            "options": { "cwd": "${workspaceFolder}" },
            "group": "test",
            "problemMatcher": []
        },
        {
            "label": "Backend: empacotar sem testes",
            "type": "shell",
            "command": "./mvnw",
            "windows": { "command": ".\\mvnw.cmd" },
            "args": ["-DskipTests", "package"],
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": []
        }
    ]
}
